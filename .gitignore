# n8n QNAP Updater - Git Ignore File

# SSH Keys and Certificates
*.key
*.cert
*.pem
*.ppk
id_rsa*
id_ed25519*

# QNAP Configuration Files
config.json
*.config

# Backup Files
*.backup
*.bak
*.tar.gz
*.zip

# Temporary Files
*.tmp
*.temp
*~

# Log Files
*.log
logs/

# PowerShell Transcript Files
PowerShell_transcript*

# n8n Container Inspect Files
*-inspect.json
n8n-config.json

# Credential Files
credentials.json
*credentials*
*.secret
.env
.env.*

# Windows System Files
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS System Files
.DS_Store
.AppleDouble
.LSOverride

# Editor/IDE Files
.vscode/
.idea/
*.swp
*.swo
*~

# Test/Debug Files
test-*.ps1
debug-*.ps1
